# Copy to .env for docker compose. Local development values only; never commit .env.
POSTGRES_USER=rsa
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rsa
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Host ports (bound to 127.0.0.1). Change if they clash with local services.
KAFKA_HOST_PORT=9092
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

# Demo producer (docker compose --profile demo up)
PRODUCER_COUNT=50000
PRODUCER_RATE=50
PRODUCER_DUPLICATE_RATE=0.02
PRODUCER_MALFORMED_RATE=0.01

# Application settings (see src/streaming/config.py for all STREAM_* options)
STREAM_LOG_LEVEL=INFO
